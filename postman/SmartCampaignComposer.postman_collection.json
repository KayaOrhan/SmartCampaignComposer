        "url": "{{baseUrl}}/campaigns/{{campaignId}}/segment",
        "body": {
          "mode": "raw",
          "raw": "{\"version\": 1, \"all\": [{\"field\": \"city\", \"op\": \"in\", \"value\": [\"ISTANBUL\"]}, {\"field\": \"cart_added\", \"op\": \"within_days\", \"value\": 30}, {\"field\": \"purchase\", \"op\": \"none_within_days\", \"value\": 30}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Canonical segment persisted\", () => { pm.expect(String(data.id)).to.eql(pm.variables.get(\"campaignId\")); pm.expect(data.status).to.eql(\"draft\"); pm.expect(data.segment).to.deep.eql({\"version\": 1, \"all\": [{\"field\": \"city\", \"op\": \"in\", \"value\": [\"istanbul\"]}, {\"field\": \"cart_added\", \"op\": \"within_days\", \"value\": 30}, {\"field\": \"purchase\", \"op\": \"none_within_days\", \"value\": 30}]}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read saved segment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
