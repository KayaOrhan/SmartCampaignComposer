{
  "info": {
    "name": "Smart Campaign Composer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API regression checks for implemented slices 1 and 2. Uses synthetic briefs and aggregate previews only. Each full run creates one persistent draft; no delete endpoint exists."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "campaignId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const target = pm.variables.replaceIn(pm.variables.get(\"baseUrl\"));",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):8080$/.test(target)) throw new Error(\"This collection permits only the local Compose API on port 8080\");"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Process healthy\", () => pm.expect(data).to.deep.eql({status:\"ok\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Database ready\", () => pm.expect(data).to.deep.eql({status:\"ready\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/campaigns",
        "body": {
          "mode": "raw",
          "raw": "{\"brief\": \"  Postman synthetic campaign  \", \"channels\": [\"email\", \"sms\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Draft contract and Location\", () => {",
              "  pm.expect(data).to.have.all.keys(\"id\", \"brief\", \"channels\", \"segment\", \"status\", \"created_at\");",
              "  pm.expect(Number.isSafeInteger(data.id) && data.id > 0).to.eql(true);",
              "  pm.expect(data.brief).to.eql(\"Postman synthetic campaign\");",
              "  pm.expect(data.channels).to.deep.eql([\"sms\", \"email\"]);",
              "  pm.expect(data.status).to.eql(\"draft\"); pm.expect(data.segment).to.eql(null);",
              "  pm.expect(data.created_at).to.match(/Z$/); pm.expect(Number.isNaN(Date.parse(data.created_at))).to.eql(false);",
              "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/campaigns/\" + data.id);",
              "});",
              "if (pm.response.code === 201 && Number.isSafeInteger(data.id) && data.id > 0) pm.collectionVariables.set(\"campaignId\", String(data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get draft",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Stored draft\", () => { pm.expect(String(data.id)).to.eql(pm.variables.get(\"campaignId\")); pm.expect(data.brief).to.eql(\"Postman synthetic campaign\"); pm.expect(data.channels).to.deep.eql([\"sms\",\"email\"]); pm.expect(data.status).to.eql(\"draft\"); pm.expect(data.segment).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Preview requires segment",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}/audience-preview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Exact safe error envelope\", () => pm.expect(data).to.deep.eql({\"error\": {\"code\": \"segment_required\", \"path\": \"$\"}}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save segment",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
