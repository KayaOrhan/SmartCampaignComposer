    },
    {
      "name": "Audience preview",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}/audience-preview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Aggregate-only preview contract\", () => {",
              " pm.expect(data).to.have.all.keys(\"as_of\",\"eligible_unique\",\"by_channel\");",
              " pm.expect(data.as_of).to.match(/Z$/); pm.expect(Number.isNaN(Date.parse(data.as_of))).to.eql(false);",
              " pm.expect(data.by_channel).to.have.all.keys(\"sms\",\"email\");",
              " const integer = n => pm.expect(Number.isSafeInteger(n) && n >= 0).to.eql(true);",
              " integer(data.eligible_unique);",
              " for (const b of Object.values(data.by_channel)) {",
              "  pm.expect(b).to.have.all.keys(\"count\",\"max_first_name_runes\",\"max_city_runes\");",
              "  Object.values(b).forEach(integer);",
              "  pm.expect(b.count).to.be.at.most(data.eligible_unique);",
              "  if (b.count === 0) { pm.expect(b.max_first_name_runes).to.eql(0); pm.expect(b.max_city_runes).to.eql(0); }",
              " }",
              " pm.expect(data.eligible_unique).to.be.at.most(data.by_channel.sms.count + data.by_channel.email.count);",
              "});"
            ]
          }
        }
      ]
    },
