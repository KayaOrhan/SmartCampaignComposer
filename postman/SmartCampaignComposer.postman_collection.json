    {
      "name": "Preview rejects body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}/audience-preview",
        "body": {
          "mode": "raw",
          "raw": "{\"channel\": \"sms\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"JSON, no-store response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
              "const data = pm.response.json();",
              "pm.test(\"Exact safe error envelope\", () => pm.expect(data).to.deep.eql({\"error\": {\"code\": \"body_not_allowed\", \"path\": \"$\"}}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unsupported method",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/campaigns/{{campaignId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 405\", () => pm.response.to.have.status(405));",
              "pm.test(\"Allow header\", () => { pm.expect(pm.response.headers.get(\"Allow\")).to.include(\"GET\"); });"
            ]
          }
        }
      ]
    }
  ]
}
