# Names only. Real values live in your local .env, which is gitignored and never read by agents.

# development | test | production
APP_ENV=development
# Required only for LLM_PROVIDER=anthropic. Never commit a real value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# mock (default) | anthropic (forbidden under APP_ENV=test)
LLM_PROVIDER=mock
LLM_MOCK_SCENARIO=happy
LLM_MOCK_MESSAGE_SCENARIO=happy
LLM_MOCK_CHUNK_DELAY=10ms
LLM_TIMEOUT=10s
DATABASE_URL=postgres://app:app@db:5432/app?sslmode=disable
HTTP_ADDR=:8080
DB_TIMEOUT=2s
SEED_DATA=false
# Must be allowlisted to the mock host.
PROVIDER_BASE_URL=http://mockprovider:8081
PROVIDER_TIMEOUT=3s
WORKER_LEASE=30s
WORKER_POLL=100ms
WORKER_CONCURRENCY=1
FAULT_SEED=1
FAULT_RATE_5XX=0.05
FAULT_RATE_429=0.02
FAULT_LATENCY_P95_MS=20
