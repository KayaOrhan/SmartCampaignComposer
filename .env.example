# Names only. Real values live in your local .env, which is gitignored and never read by agents.

# development | test
APP_ENV=development
# Reserved for later Claude integration; 3A uses the mock without reading this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock only in 3A; anthropic is rejected until its adapter is implemented
LLM_PROVIDER=mock
LLM_MOCK_SCENARIO=happy
LLM_TIMEOUT=10s
DATABASE_URL=postgres://app:app@db:5432/app?sslmode=disable
HTTP_ADDR=:8080
DB_TIMEOUT=2s
SEED_DATA=false
# Must be allowlisted to the mock host.
PROVIDER_BASE_URL=http://mockprovider:8081
